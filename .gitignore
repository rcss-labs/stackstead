# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Secrets and credentials; example templates stay tracked
# (.env.example / .env.*.example are re-included below)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Local databases and their WAL/journal side files
*.db
*.sqlite
*.sqlite3
*.sqlite-*

# Root-level local config (deploy/config.example.yaml stays tracked)
/config.yaml

# Editor/IDE
.idea/
.vscode/

# Build output
bin/
.dev/
node_modules/
dist/
# web/dist is tracked only as a placeholder; its own .gitignore hides build output
!web/dist/
web/dist/*
!web/dist/.gitignore

# Local tool state (brainstorming companion, SDD ledgers)
.superpowers/
docs/superpowers/

# design-sync (claude.ai/design) build state
web/.ds-sync/
web/.ds-pkg/
web/ds-bundle/
web/.design-sync/.cache/
web/.design-sync/learnings/
web/.design-sync/node_modules
