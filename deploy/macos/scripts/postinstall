#!/bin/sh
# Stackstead .pkg postinstall. Runs as root, started by installer(8) with
#   $1 package path  $2 install location  $3 target volume  $4 root of the system
#
# What it does: nothing for a non-boot volume ("staged only"); otherwise it hands
# the per-user setup (directories, config, LaunchAgent, start) to the installed
# install.sh --from-pkg for the console user. install.sh does every file operation
# in that user's home AS that user (root never writes there or follows the user's
# symlinks) and refuses uid 0.
#
# Which user: the owner of /dev/console, i.e. the person logged in at the Mac. The
# environment the installer was started with (USER, SUDO_USER, HOME, TMPDIR) is not
# trusted and is not passed on. With nobody logged in (ssh, MDM at the login
# window) the owner is root: the installation still succeeds, and the message says
# how to finish it. The postinstall never fails the installation because the
# agent could not be set up; the package files are in place either way.
#
# Test seams (STACKSTEAD_PKG_PATH, STACKSTEAD_PKG_HELPER) are honoured only when
# this script is NOT running as root, so they cannot redirect a real install.
set -eu

HELPER=/usr/local/share/stackstead/install.sh
if [ "$(id -u)" -eq 0 ]; then
	PATH=/usr/bin:/bin:/usr/sbin:/sbin
else
	PATH=${STACKSTEAD_PKG_PATH:-$PATH}
	HELPER=${STACKSTEAD_PKG_HELPER:-$HELPER}
fi
export PATH

volume=${3:-/}
if [ "$volume" != / ]; then
	echo "Stackstead: installed to $volume: files staged only, no user agent was set up."
	exit 0
fi

# finish_by_hand REASON: succeed, and say how to set the agent up later.
finish_by_hand() {
	echo "Stackstead: $1; the package files are installed."
	echo "Stackstead: to set up the agent for a user, run:  sudo $HELPER --from-pkg --user <name>"
	exit 0
}

console_user=$(stat -f %Su /dev/console 2>/dev/null) || console_user=
case $console_user in
"" | root) finish_by_hand "no user is logged in at the console" ;;
_* | -* | *[!A-Za-z0-9._-]*) finish_by_hand "the console user is not a regular account" ;;
esac
if [ "$(id -u "$console_user" 2>/dev/null || echo 0)" -eq 0 ]; then
	finish_by_hand "the console user has uid 0"
fi
if [ ! -f "$HELPER" ]; then
	finish_by_hand "$HELPER is missing"
fi

echo "Stackstead: setting up the LaunchAgent for $console_user"
status=0
# A clean environment: nothing the installer was started with reaches install.sh.
env -i PATH="$PATH" /bin/sh "$HELPER" --from-pkg --user "$console_user" || status=$?
if [ "$status" -ne 0 ]; then
	echo "Stackstead: the agent setup did not finish (install.sh exit status $status); the package files are installed." >&2
	echo "Stackstead: retry as an administrator:  sudo $HELPER --from-pkg --user $console_user" >&2
fi
exit 0
