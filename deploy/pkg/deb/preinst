#!/bin/sh
# Debian preinst: create the service group and user before files are unpacked.
set -e

ensure_identity() {
    getent group docker >/dev/null 2>&1 || groupadd --system docker
    getent group stackstead >/dev/null 2>&1 || groupadd --system stackstead
    # The user is also put in the docker group in /etc/group (not only via the
    # unit's SupplementaryGroups) so `id stackstead` and ad-hoc shells agree.
    if getent passwd stackstead >/dev/null 2>&1; then
        usermod -aG docker stackstead
    else
        useradd --system --gid stackstead --groups docker --home-dir /var/lib/stackstead \
            --no-create-home --shell /usr/sbin/nologin stackstead
    fi
}

case "$1" in
    install | upgrade)
        ensure_identity
        ;;
    abort-upgrade) ;;
    *)
        echo "preinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac
exit 0
