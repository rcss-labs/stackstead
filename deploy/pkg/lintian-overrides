# Go binaries are statically linked by design (CGO_ENABLED=0 release builds).
stackstead: statically-linked-binary
# Manual page deferred; `stackstead --help` and the README cover usage for now.
stackstead: no-manual-page
# nfpm does not generate a changelog; release notes live on the GitHub release page.
stackstead: no-changelog
# The maintainer scripts call systemctl directly (guarded, best-effort) instead of
# debhelper's deb-systemd-helper, because nfpm does not run debhelper.
stackstead: maintainer-script-calls-systemctl
# The state directory is 0700 and the config is 0640 root:stackstead on purpose: both can hold secrets.
stackstead: non-standard-dir-perm
stackstead: non-standard-file-perm
# nfpm emits a License field in the control file; it is informational only.
stackstead: unknown-field License
# stackstead only stats its own file list (/var/lib/dpkg/info/stackstead.list) to tell a deb install
# from a script install, and `stackstead upgrade` probes the dpkg frontend lock (F_SETLK, released at
# once) so it can report "busy" instead of racing apt; it never reads or writes the dpkg database.
stackstead: uses-dpkg-database-directly [usr/bin/stackstead]
