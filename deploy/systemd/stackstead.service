[Unit]
Description=Stackstead Docker stack manager
Documentation=https://github.com/rcss-labs/stackstead
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=stackstead
Group=stackstead
# Docker group membership is root-equivalent on the host; the hardening below
# limits accidents in Stackstead's own process, it is not a security boundary.
SupplementaryGroups=docker
Environment=DOCKER_CONFIG=/var/lib/stackstead/.docker
# A config typo fails here with the key name in the journal.
ExecStartPre=/usr/bin/stackstead config validate --config /etc/stackstead/config.yaml
ExecStart=/usr/bin/stackstead serve --config /etc/stackstead/config.yaml
Restart=on-failure
RestartSec=5
StateDirectory=stackstead
StateDirectoryMode=0700
# Group-writable new files and directories (0660/0770): admins in the docker group
# can edit stacks the service created. The state dir itself stays 0700.
UMask=0007

# Hardening. ProtectSystem=full makes /usr, /boot and /etc read-only and
# PrivateTmp hides the real /tmp. Compose files under /etc or /usr can only be
# edited after a drop-in (`systemctl edit stackstead`) adds ReadWritePaths=/path;
# files under /tmp additionally need PrivateTmp=no in that drop-in.
# Deliberately not ProtectSystem=strict and no ProtectHome: stacks
# are compose files the user registers anywhere on the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
